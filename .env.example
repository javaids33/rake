# RustLake Environment Variables
# Copy to .env and adjust for your environment.

# ── Logging ──────────────────────────────────────────
RUST_LOG=info

# ── API Server ───────────────────────────────────────
RUSTLAKE_API__HOST=127.0.0.1
RUSTLAKE_API__PORT=3000

# ── Arrow Flight gRPC (disabled by default) ──────────
RUSTLAKE_FLIGHT__ENABLED=false
# RUSTLAKE_FLIGHT__HOST=0.0.0.0
# RUSTLAKE_FLIGHT__PORT=50051

# ── Cluster Mode ─────────────────────────────────────
RUSTLAKE_CLUSTER__NODE_ROLE=standalone
# Options: standalone, coordinator, worker
# RUSTLAKE_CLUSTER__COORDINATOR_ADDR=http://coordinator:50051

# ── Auto-Bootstrap (disabled by default) ─────────────
# Set to "true" to auto-connect Docker services on startup.
# Otherwise, add data sources manually via the UI or POST /api/v1/connections.
RUSTLAKE_AUTO_BOOTSTRAP=false

# ── Postgres (used by bootstrap and connections) ─────
RUSTLAKE_PG_HOST=localhost
RUSTLAKE_PG_PORT=5433
RUSTLAKE_PG_DB=rustlake_demo
RUSTLAKE_PG_USER=rustlake
RUSTLAKE_PG_PASSWORD=rustlake

# ── MySQL (used by bootstrap and connections) ────────
RUSTLAKE_MYSQL_HOST=localhost
RUSTLAKE_MYSQL_PORT=3307
RUSTLAKE_MYSQL_DB=rustlake_demo
RUSTLAKE_MYSQL_USER=rustlake
RUSTLAKE_MYSQL_PASSWORD=rustlake

# ── MongoDB (used by bootstrap and connections) ──────
RUSTLAKE_MONGO_HOST=localhost
RUSTLAKE_MONGO_PORT=27018
RUSTLAKE_MONGO_DB=rustlake_demo
RUSTLAKE_MONGO_USER=rustlake
RUSTLAKE_MONGO_PASSWORD=rustlake

# ── MinIO / S3 (used by bootstrap) ──────────────────
RUSTLAKE_MINIO_ENDPOINT=http://localhost:9000
RUSTLAKE_MINIO_ACCESS_KEY=rustlake
RUSTLAKE_MINIO_SECRET_KEY=rustlake123
RUSTLAKE_MINIO_BUCKET=rustlake-warehouse
RUSTLAKE_MINIO_REGION=us-east-1

# ── Storage ──────────────────────────────────────────
# RUSTLAKE_STORAGE__DATA_DIR=/opt/rustlake/data
